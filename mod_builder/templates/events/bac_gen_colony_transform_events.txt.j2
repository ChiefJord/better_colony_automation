namespace = colony_automation_event

# 隐形前置处理/刷新事件
country_event = {
    id = colony_automation_event.109
    hide_window = yes
    is_triggered_only = yes

    trigger = {
        is_ai = no
    }

    immediate = {
        # Reset the shared candidate list.
        set_variable = {
            which = bca_world_transform_candidate_planet_count
            value = 0
        }
        # Gather valid Arcology and Arkship-upgrade candidates.
        every_owned_colony = {
            limit = {
				OR = {
					has_modifier = bca_pm_arcology_project_candidate
					has_modifier = bca_pm_arkship_upgrade_candidate
				}
            }
            if = {
                limit = {
                    has_modifier = bca_pm_arcology_project_candidate
					bca_can_be_arcology_project_candidate = no
                }
                carrier_event = { id=colony_automation_event.100 }
            }
            else_if = {
                limit = {
					has_modifier = bca_pm_arkship_upgrade_candidate
					NOR = {
						bca_can_upgrade_arkship_to_tier_2 = yes
						bca_can_upgrade_arkship_to_tier_3 = yes
					}
				}
				carrier_event = { id=colony_automation_event.100 }
			}
			else_if = {
				limit = {
					OR = {
						AND = {
							has_modifier = bca_pm_arcology_project_candidate
							bca_has_resource_for_arcology_project = yes
                    OR = {
                        AND = {
                            free_district_slots < 1
                            num_uncleared_blockers < 1
                            check_variable = {
                                which = bca_num_queued_districts
                                value = 0
                            }
                            num_districts = { type = district_farming value < 1 }
                            num_districts = { type = district_mining value < 1 }
                            num_districts = { type = district_generator value < 1 }
                            # Volcanic Worlds
                            num_districts = { type = district_geothermal value < 1 }
                            num_districts = { type = district_melting value < 1 }
                            num_districts = { type = district_polytechnic value < 1 }

                            NOT = { has_carrier_flag = legendary_leader_planet }
                        }
                        AND = {
                            is_planet_class = pc_relic
                            is_artificial = no
                            exists = owner
                            num_uncleared_blockers < 1
                            owner = { has_technology = tech_housing_2 }
                        }
                    }
						}
						AND = {
							has_modifier = bca_pm_arkship_upgrade_candidate
							bca_has_resource_for_arkship_upgrade = yes
						}
					}
                }
                {% for i in range(1, 10) %}
                    {{ "if" if loop.first else "else_if" }} = {
                        limit = {
                            owner = {
                                check_variable = {
                                    which = bca_world_transform_candidate_planet_count
                                    value = {{ i - 1 }}
                                }
                            }
                        }
                        owner = {
                            add_variable = {
                                which = bca_world_transform_candidate_planet_count
                                value = 1
                            }
                        }
						save_event_target_as = bca_world_transform_candidate_planet_{{ "%02d"|format(i) }}
                    }
                {% endfor %}
            }
        }

        # Show the list for multiple candidates, otherwise open its confirmation.
        if = {
            limit = {
                check_variable = {
                    which = bca_world_transform_candidate_planet_count
                    value >= 2
                }
            }
            country_event = { id = colony_automation_event.110 }
        }
        else_if = {
            limit = {
                check_variable = {
                    which = bca_world_transform_candidate_planet_count
                    value = 1
                }
            }
			event_target:bca_world_transform_candidate_planet_01 = {
                carrier_event = { id = colony_automation_event.102 }
            }
        }
    }
}

country_event = {
    id = colony_automation_event.110
    is_triggered_only = yes
    title = colony_automation_event.110.name
    desc = colony_automation_event.110.desc
    picture = GFX_evt_metropolis
    show_sound = event_administrative_work

    option = {
        name = colony_automation_event.110.locate_all
        trigger = {
                check_variable = {
                    which = bca_world_transform_candidate_planet_count
                    value > 0
            }
        }
        hidden_effect = {
            {% for i in range(1, 10) %}
                if = {
                    limit = {
                        check_variable = {
                            which = bca_world_transform_candidate_planet_count
                            value >= {{ i }}
                        }
						exists = event_target:bca_world_transform_candidate_planet_{{ "%02d"|format(i) }}
                    }
                    create_message = {
                        type = MESSAGE_BCA_WORLD_TRANSFORM_CANDIDATE_LOCATE
                        days = 1
                        localization = MESSAGE_BCA_WORLD_TRANSFORM_CANDIDATE_LOCATE_DESC
                        target = event_target:bca_world_transform_candidate_planet_{{ "%02d"|format(i) }}.carrier
                        variable = {
                            type = name
                            localization = PLANET
							scope = event_target:bca_world_transform_candidate_planet_{{ "%02d"|format(i) }}.carrier
                        }
                    }
                }
            {% endfor %}
        }
    }

    {% for i in range(1, 10) %}
        option = {
            name = colony_automation_event.110.opt.{{ "%02d"|format(i) }}
            trigger = {
                # Use the refreshed count to avoid stale event targets.
                check_variable = {
                    which = bca_world_transform_candidate_planet_count
                    value >= {{ i }}
                }
				exists = event_target:bca_world_transform_candidate_planet_{{ "%02d"|format(i) }}
            }
            hidden_effect = {
				event_target:bca_world_transform_candidate_planet_{{ "%02d"|format(i) }} = {
                    carrier_event = { id = colony_automation_event.102 }
                }
            }
        }
    {% endfor %}

    option = {
        name = CLOSE
    }
}
